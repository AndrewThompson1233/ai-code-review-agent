# Copy to .env and fill in. Never commit a real .env.
# All values are optional for local usage; the agent degrades gracefully.

# --- LLM provider ---
# One of: openai | anthropic | local
AI_PROVIDER=openai

# Model name (passed verbatim to the provider).
# Examples: gpt-4o-mini, gpt-4.1, claude-3-5-sonnet-20241022,
# qwen2.5-coder-7b-instruct (for local OpenAI-compatible servers)
AI_MODEL=

# API key. Required for hosted providers; ignored by `local`.
AI_API_KEY=

# Base URL override. Leave empty for provider defaults.
# Examples:
#   https://api.openai.com/v1
#   https://api.anthropic.com
#   http://localhost:8000/v1   (llama.cpp / vllm / ollama OpenAI-compatible)
# Note: Azure OpenAI is NOT supported — its deployment-based URL scheme and
# auth differ from the public OpenAI API. Use a local proxy if you need Azure.
AI_BASE_URL=

# Sampling parameters.
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_TIMEOUT=120
AI_RETRIES=3

# --- GitHub integration (only needed for PR review) ---
# Classic PAT or fine-grained token with `pull_requests: write` and `contents: read`.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Review behavior ---
# 0.0..1.0. Issues below this confidence are dropped (never posted).
REVIEW_MIN_CONFIDENCE=0.7
REVIEW_MAX_FILES=50
REVIEW_MAX_FILE_SIZE=524288
REVIEW_MAX_CONTEXT_SIZE=65536
# Whole-pipeline timeout in seconds. Caps total wall-clock of the review,
# independent of per-request AI_TIMEOUT.
REVIEW_TIMEOUT=300
# Max number of files reviewed in parallel. Bounded to respect rate limits.
REVIEW_CONCURRENCY=3

# --- Output ---
# 0 = quiet, 1 = info, 2 = debug
LOG_LEVEL=1
